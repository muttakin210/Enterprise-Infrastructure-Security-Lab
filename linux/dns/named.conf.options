acl lab_nets { 127.0.0.0/8; 192.168.10.0/24; 192.168.20.0/24; 192.168.30.0/24; 192.168.40.0/24; 192.168.50.0/24; };
options {
    directory "/var/cache/bind";
    recursion yes;
    allow-recursion { lab_nets; };
    allow-query { lab_nets; };
    allow-transfer { none; };
    forwarders { 1.1.1.1; 9.9.9.9; };
    dnssec-validation auto;
    listen-on { any; };
    listen-on-v6 { none; };
    version "not disclosed";
    querylog yes;
};
